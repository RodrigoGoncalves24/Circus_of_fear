[sub_resource type="GDScript" id="GDScript_1ywl6"]
script/source = "extends Node2D

signal entregou_item(item_data)
@onready var animations: AnimationPlayer = $AnimationPlayer
@export var item_tipo: String = \"municao\"
@export var quantidade := 5
var aberto = false

func _on_body_entered(body):
	if body.is_in_group(\"crianca\") and not aberto:
		aberto = true
		animations.play(\"open\") 
		await animations.animation_finished
		emitir_item(body)
		
func emitir_item(player):
	var item_data = {
		\"tipo\": item_tipo,
		\"quantiade\": quantidade
		}
	emit_signal(\"entregou item\", item_data)
	
"

